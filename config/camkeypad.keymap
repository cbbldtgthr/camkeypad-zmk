#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // Open Camera: volume up = shutter / start-stop video, volume down = pause/resume
            // Zoom encoder: turn = zoom in/out; click toggles Open Camera's exposure panel while testing the wiring
            bindings = <&kp C_VOL_UP &kp C_VOL_DN &kp KP_DIVIDE>;
            // With this wiring ZMK reads a right turn as its counter-clockwise direction, the second key
            sensor-bindings = <&inc_dec_kp KP_MINUS KP_PLUS>;
        };
    };
};
